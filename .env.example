# TypeSafe API key, used server-side to call Jev
TYPESAFE_API_KEY=
# Anthropic API key, used server-side for card text
ANTHROPIC_API_KEY=
# Google OAuth client ID for Gmail access
GOOGLE_CLIENT_ID=
# Google OAuth client secret (server-side only)
GOOGLE_CLIENT_SECRET=
# Pinned Jev model version (never use jev-latest)
JEV_MODEL=jev-1.14.0
# Claude model used for card text
CLAUDE_MODEL=claude-haiku-5-5
# Where the web app is served; the Google sign-in sends you back here (default http://localhost:5173)
WEB_ORIGIN=http://localhost:5173
# Port the API server listens on (default 8787; the Vite proxy expects 8787)
# JEV_SWEEP_PORT=8787
